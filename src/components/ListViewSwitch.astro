---
interface Props { target: string; page: string; defaultView?: "grid" | "list" }
const { target, page, defaultView = "grid" } = Astro.props;
---
<div class="list-view-switch" data-list-switch data-target={target} data-page={page} data-default-view={defaultView} role="group" aria-label="一覧の表示方法">
  <button type="button" class:list={["control-btn", { active: defaultView === "list" }]} data-view="list" aria-pressed={defaultView === "list"} aria-controls={target} aria-label="リスト表示" title="リスト表示">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 6h11M9 12h11M9 18h11M4 6h1M4 12h1M4 18h1" /></svg>
  </button>
  <button type="button" class:list={["control-btn", { active: defaultView === "grid" }]} data-view="grid" aria-pressed={defaultView === "grid"} aria-controls={target} aria-label="グリッド表示" title="グリッド表示">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="2" /><rect x="14" y="3" width="7" height="7" rx="2" /><rect x="3" y="14" width="7" height="7" rx="2" /><rect x="14" y="14" width="7" height="7" rx="2" /></svg>
  </button>
</div>
<script>
  import { initializeListControls } from "../../assets/js/listControls.js";
  initializeListControls();
  document.addEventListener("astro:page-load", () => initializeListControls());
</script>
