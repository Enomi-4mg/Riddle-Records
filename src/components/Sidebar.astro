---
const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base : `${base}/`;
const href = (path) => `${basePath}${path.replace(/^\/+/, "")}`;
---

<div class="sidebar-overlay" hidden></div>
<nav id="mobile-navigation" class="sidebar" aria-label="モバイルナビゲーション" aria-hidden="true" inert>
  <button class="sidebar-close" type="button" aria-label="メニューを閉じる">×</button>
  <div class="sidebar_content">
    <ul class="sidebar_menu">
      <li class="menu_item"><a href={href("/")} class={Astro.url.pathname === basePath || Astro.url.pathname === `${basePath}index.html` ? "active" : ""} aria-current={Astro.url.pathname === basePath || Astro.url.pathname === `${basePath}index.html` ? "page" : undefined}>Home</a></li>
      <li class="menu_item"><a href={href("/about/")} class={Astro.url.pathname.includes(`${basePath}about`) ? "active" : ""} aria-current={Astro.url.pathname.includes(`${basePath}about`) ? "page" : undefined}>About</a></li>
      <li class="menu_item"><a href={href("/journal/")} class={Astro.url.pathname.includes(`${basePath}journal`) ? "active" : ""} aria-current={Astro.url.pathname.includes(`${basePath}journal`) ? "page" : undefined}>Journal</a></li>
      <li class="menu_item"><a href={href("/works/")} class={Astro.url.pathname.includes(`${basePath}works`) || Astro.url.pathname.includes(`${basePath}gallery`) || Astro.url.pathname.includes(`${basePath}disco`) ? "active" : ""} aria-current={Astro.url.pathname.includes(`${basePath}works`) || Astro.url.pathname.includes(`${basePath}gallery`) || Astro.url.pathname.includes(`${basePath}disco`) ? "page" : undefined}>Works</a></li>
      <li class="menu_item"><a href={href("/project/")} class={Astro.url.pathname.includes(`${basePath}project`) ? "active" : ""} aria-current={Astro.url.pathname.includes(`${basePath}project`) ? "page" : undefined}>Project</a></li>
    </ul>
  </div>
</nav>

<style is:global>
  .sidebar {
    position: fixed;
  }

  .sidebar-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: rgba(244, 255, 250, 0.22);
    color: #0a1510;
    font: inherit;
    font-size: 2rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 1001;
  }

  .sidebar-close:active,
  .sidebar-close:focus-visible {
    background: rgba(244, 255, 250, 0.42);
    outline: 3px solid var(--color-ink);
    outline-offset: 3px;
  }
</style>
