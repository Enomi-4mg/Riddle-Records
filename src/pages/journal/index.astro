---
import { formatDate } from "../../../shared/formatDate.js";
import { contentSummary } from "../../../shared/contentSummary";
import ListViewSwitch from "../../components/ListViewSwitch.astro";
import SortSwitch from "../../components/SortSwitch.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { hasVisiblePublicationDate } from "../../../shared/publicationDate";
import { getGalleryItems } from "../../utils/gallery";
import { getJournalRoutePath, getJournalThumbnail } from "../../utils/journal";
import fallbackIconUrl from "../../../favicon/icon.jpg?url";

const base = import.meta.env.BASE_URL;
const showDrafts = !import.meta.env.PROD;
const galleryItems = await getGalleryItems();
const journalEntries = (await getCollection("journal"))
  .filter((entry) => hasVisiblePublicationDate(entry.data, showDrafts))
  .sort((left, right) => right.data.date.getTime() - left.data.date.getTime());

const basePath = base.endsWith("/") ? base : `${base}/`;
const withBase = (path) => `${basePath}${path.replace(/^\/+/, "")}`;
const getJournalUrl = (entry) => withBase(`/journal/${getJournalRoutePath(entry)}/`);
const getJournalSummary = (entry) => contentSummary(entry.data.description, entry.data.og_description);
---

<BaseLayout title="Journal" description="日記・活動報告の一覧。" wideContainer={true}>
  <h1 class="web_title">Journal</h1>

  <div class="index-toolbar"><div class="index-view-controls"><SortSwitch target="journal-index" /><ListViewSwitch target="journal-index" page="journal" defaultView="list" /></div></div>

  <div class="content-index" id="journal-index" data-view="list">
    {journalEntries.map((entry) => {
      const thumbnail = getJournalThumbnail(entry, galleryItems, fallbackIconUrl);
      const articleUrl = getJournalUrl(entry);
      return (
        <article class="content-item journal-row journal-entry-animate" data-date={entry.data.date.toISOString()}>
          <a href={articleUrl} class="journal-thumb">
            <img
              src={thumbnail.src}
              alt={thumbnail.alt}
              loading="lazy"
            />
          </a>
          <div class="journal-copy">
            <time class="journal-date" datetime={entry.data.date.toISOString().slice(0, 10)}>{formatDate(entry.data.date)}</time>
            <h2 class="journal-title"><a href={articleUrl}>{entry.data.title}</a></h2>
            <p class="journal-desc">{getJournalSummary(entry)}</p>
          </div>
        </article>
      );
    })}
  </div>
</BaseLayout>
