---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getAboutPageData } from "../utils/about";
import { galleryWorkPath } from "../utils/works";
import { resolveImageUrl } from "../utils/images";
import profileIconUrl from "../../favicon/icon.jpg?url";
const { profile, featuredWorks } = await getAboutPageData();
const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\/+/, "")}`;
const icon = profile.icon.startsWith("/") ? href(profile.icon) : resolveImageUrl(profile.icon) || profileIconUrl;
const birthday = profile.birthday ? `${profile.birthday.slice(0, 2)}月${profile.birthday.slice(3)}日` : "";
const groups = [{ label: "趣味", values: profile.hobbies }, { label: "特技", values: profile.skills }, { label: "好きなもの", values: profile.likes }];
---
<BaseLayout title="About" description={`${profile.name}のプロフィールとリンク集。`}>
  <h1 class="web_title">About</h1>
  <section class="profile-card journal-entry-animate">
    <div class="profile-avatar-wrap"><img class="profile-avatar" alt={`${profile.name}のプロフィール画像`} src={icon} /></div>
    <div class="profile-content">
      <h2 class="profile-name">{profile.name}</h2><p class="profile-bio">{profile.bio}</p>
      <dl class="profile-meta">
        {birthday && <div class="meta-row"><dt>誕生日</dt><dd>{birthday}</dd></div>}
        {profile.motto && <div class="meta-row"><dt>座右の銘</dt><dd>{profile.motto}</dd></div>}
      </dl>
      <div class="profile-tags">{groups.filter((group) => group.values.length).map((group) => <div class="tag-group"><span class="tag-label">{group.label}</span><div class="tag-items">{group.values.map((tag) => <span class="tag">{tag}</span>)}</div></div>)}</div>
    </div>
  </section>
  {profile.sns.length > 0 && <section class="profile-links journal-entry-animate"><h2 class="page_title profile-section-title">リンク集</h2><ul class="link-list"><li class="platform-icons" aria-label="プラットフォーム">{profile.sns.map((item) => <a href={item.url} target="_blank" rel="noopener noreferrer" aria-label={item.label || item.service}>{item.label || item.service}</a>)}</li></ul></section>}
  <section class="works-preview journal-entry-animate">
    <h2 class="page_title profile-section-title">最近の作品・おすすめ作品</h2>
    {featuredWorks.length > 0 ? <div class="works-grid">{featuredWorks.map((work) => <div class="work-card"><a href={href(galleryWorkPath(work.id))} class="work-thumb"><img src={work.thumbnail} alt={work.imageAlt} loading="lazy" /></a><div class="work-info"><p class="work_title">{work.title}</p><time datetime={work.date} class="work_date">{new Date(work.date).toLocaleDateString("ja-JP")}</time></div></div>)}</div> : <p class="profile-featured-empty">紹介する作品は準備中です。</p>}
    <p class="works-preview-link"><a class="home-card-cta" href={href("/works/")}>Works一覧を見る →</a></p>
  </section>
</BaseLayout>
