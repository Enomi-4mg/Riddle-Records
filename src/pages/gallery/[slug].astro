---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getGalleryDetailItems } from "../../utils/gallery";
import { resolveImageUrl } from "../../utils/images";
import { renderContentMarkdown } from "../../utils/renderMarkdown";

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base : `${base}/`;
const href = (path) => `${basePath}${path.replace(/^\/+/, "")}`;
const formatDate = (date: string) => new Date(date).toLocaleDateString("ja-JP");

export async function getStaticPaths() {
  return (await getGalleryDetailItems()).map((item) => ({
    params: {
      slug: item.slug
    },
    props: {
      item
    }
  }));
}

const { item } = Astro.props;
const imageUrl = resolveImageUrl(item.image, "w_1400,q_auto,f_auto");
const ogImage = resolveImageUrl(item.image, "w_1200,h_630,c_fill,q_auto,f_jpg");
const twitterImage = resolveImageUrl(item.image, "w_1200,h_628,c_fill,q_85,f_jpg");
const bodyHtml = await renderContentMarkdown(item.body);
---

<BaseLayout
  title={item.title}
  description={item.description}
  ogTitle={item.title}
  ogDescription={item.description}
  ogType="article"
  ogImage={ogImage}
  ogImageAlt={item.title}
  twitterImage={twitterImage}
  twitterImageAlt={item.title}
>
  <article class="gallery-detail journal-article journal-entry-animate">
    <div class="journal-back-link journal-back-link-top">
      <a href={href("/works/")}>Works一覧へ戻る</a>
    </div>

    <header class="journal-hero">
      <p class="journal-date"><time datetime={item.date}>{formatDate(item.date)}</time></p>
      <h1 class="page_title">{item.title}</h1>
      <p class="journal-summary">{item.description}</p>
    </header>

    <div class="journal-content work-detail-content">
      <a
        class="work-detail-image"
        href={resolveImageUrl(item.image, "w_1920,q_auto,f_auto")}
        data-lightbox={`gallery-detail-${item.slug}`}
        data-title={`${item.title} - ${item.description}`}
      >
        <img src={imageUrl} alt={item.imageAlt} />
      </a>

      <div class="work-tags" aria-label={`${item.title} tags`}>
        {item.tags.map((category) => <span class="work-tag">{category}</span>)}
      </div>

      <div class="rendered-markdown" set:html={bodyHtml} />

      {(item.article_url || item.making_article_url) && (
        <section class="work-detail-links">
          <h2>関連記事</h2>
          <div class="article-links-horizontal">
            {item.article_url && <a href={href(item.article_url)} class="article-link-btn">作品記事</a>}
            {item.making_article_url && <a href={href(item.making_article_url)} class="article-link-btn making-link">メイキング</a>}
          </div>
        </section>
      )}
    </div>

    <div class="journal-back-link">
      <a href={href("/works/")}>Works一覧へ戻る</a>
    </div>
  </article>
</BaseLayout>
