---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getSortedProjectItems } from "../../utils/projects";

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base : `${base}/`;
const href = (path) => `${basePath}${path.replace(/^\/+/, "")}`;
const sortedProjects = await getSortedProjectItems();
const formatDate = (date) => new Date(date).toLocaleDateString("ja-JP");
---

<BaseLayout title="Project" description="制作したアプリ・Web作品などのプロジェクト一覧。" wideContainer={true}>
  <h1 class="web_title">Project</h1>

  <div class="journal-list project-list">
    {sortedProjects.map((project) => (
      <article class="journal-row project-row journal-entry-animate">
        <a href={href(`/project/${project.slug}/`)} class={`journal-thumb project-thumb${project.hero ? "" : " project-thumb-fallback"}`}>
          {project.hero ? (
            <img src={project.hero} alt={`${project.title} preview`} loading="lazy" />
          ) : (
            <span>{project.title}</span>
          )}
        </a>

        <div class="journal-copy">
          {project.date && <time class="journal-date" datetime={project.date}>{formatDate(project.date)}</time>}
          <h2 class="journal-title">
            <a href={href(`/project/${project.slug}/`)}>{project.title}</a>
          </h2>
          <p class="journal-desc">{project.description}</p>
          <div class="project-tags" aria-label={`${project.title} tags`}>
            {project.status && <span class="project-tag">{project.status}</span>}
            {project.tags.map((tag) => <span class="project-tag">{tag}</span>)}
          </div>
        </div>
      </article>
    ))}
  </div>
</BaseLayout>
