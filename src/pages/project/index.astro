---
import SortSwitch from "../../components/SortSwitch.astro";
import ListViewSwitch from "../../components/ListViewSwitch.astro";
import { projectStatusLabel } from "../../../shared/projectStatus";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getSortedProjectItems } from "../../utils/projects";
import { resolveImageUrl } from "../../utils/images";

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base : `${base}/`;
const href = (path) => `${basePath}${path.replace(/^\/+/, "")}`;
const sortedProjects = await getSortedProjectItems();
const formatDate = (date) => new Date(date).toLocaleDateString("ja-JP");
---

<BaseLayout title="Project" description="制作したアプリ・Web作品などのプロジェクト一覧。" wideContainer={true}>
  <h1 class="web_title">Project</h1>

  <div class="index-toolbar"><div class="index-view-controls"><SortSwitch target="project-index" /><ListViewSwitch target="project-index" page="project" defaultView="grid" /></div></div>

  <div class="content-index project-list" id="project-index" data-view="grid">
    {sortedProjects.map((project) => (
      <article class="content-item journal-row project-row journal-entry-animate" data-date={project.date}>
        <a href={href(`/project/${project.slug}/`)} class={`journal-thumb project-thumb${project.hero ? "" : " project-thumb-fallback"}`}>
          {project.hero ? (
            <img src={resolveImageUrl(project.hero)} alt={`${project.title} preview`} loading="lazy" />
          ) : (
            <span>{project.title}</span>
          )}
        </a>

        <div class="journal-copy">
          {project.date && <time class="journal-date" datetime={project.date}>{formatDate(project.date)}</time>}
          <h2 class="journal-title">
            <a href={href(`/project/${project.slug}/`)}>{project.title}</a>
          </h2>
          <p class="journal-desc">{project.description}</p>
          {project.status && <p class="project-status" data-status={project.status}>状態: {projectStatusLabel(project.status)}</p>}
          <div class="project-tags" aria-label={`${project.title} tags`}>
            {project.tags.map((tag) => <span class="project-tag">{tag}</span>)}
          </div>
        </div>
      </article>
    ))}
  </div>
</BaseLayout>
