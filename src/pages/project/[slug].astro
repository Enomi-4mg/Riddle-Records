---
import { formatDate } from "../../../shared/formatDate.js";
import { projectStatusLabel } from "../../../shared/projectStatus";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProjectItems } from "../../utils/projects";
import { resolveImageUrl } from "../../utils/images";
import { renderSiteMarkdown } from "../../utils/siteEmbeds";

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base : `${base}/`;
const href = (path) => `${basePath}${path.replace(/^\/+/, "")}`;

export async function getStaticPaths() {
  const projects = await getProjectItems();
  return projects.map((project) => ({
    params: {
      slug: project.slug
    },
    props: {
      project
    }
  }));
}

const { project } = Astro.props;
const heroUrl = resolveImageUrl(project.hero);
const bodyHtml = await renderSiteMarkdown(project.body || project.description || "");
---

<BaseLayout
  title={project.title}
  description={project.description}
  ogTitle={project.title}
  ogDescription={project.description}
  ogType="article"
  ogImage={heroUrl}
  ogImageAlt={project.title}
>
  <article class="project-detail journal-article journal-entry-animate">
    <div class="journal-back-link journal-back-link-top">
      <a href={href("/project/")}>Project一覧へ戻る</a>
    </div>

    <header class="journal-hero project-detail-header">
      {project.date && <p class="journal-date"><time datetime={project.date}>{formatDate(project.date)}</time></p>}
      <h1 class="page_title">{project.title}</h1>
      {project.status && <p class="project-status" data-status={project.status}>状態: {projectStatusLabel(project.status)}</p>}
      <p class="journal-summary">{project.description}</p>
    </header>

    <div class="journal-content project-content">
      <div class={`project-hero${heroUrl ? "" : " project-hero-fallback"}`}>
        {heroUrl ? (
          <img src={heroUrl} alt={`${project.title} preview`} />
        ) : (
          <span>{project.title}</span>
        )}
      </div>

      <section class="project-section">
        <h2>概要</h2>
        <div class="rendered-markdown" set:html={bodyHtml} />
      </section>

      {project.features.length > 0 && <section class="project-section">
        <h2>主な機能</h2>
        <ul class="project-feature-list">
          {project.features.map((feature) => <li>{feature}</li>)}
        </ul>
      </section>}

      {project.tags.length > 0 && <section class="project-section">
        <h2>タグ</h2>
        <div class="project-tags" aria-label={`${project.title} tags`}>
          {project.tags.map((tag) => <span class="project-tag">{tag}</span>)}
        </div>
      </section>}

      {project.links.length > 0 && <section class="project-section">
        <h2>リンク</h2>
        <div class="project-actions">
          {project.links.map((link, index) => (
            <a href={link.url} class={`project-action${index === 0 ? " project-action-primary" : ""}`} target="_blank" rel="noopener noreferrer">{link.label}</a>
          ))}
        </div>
      </section>}
    </div>

    <div class="journal-back-link">
      <a href={href("/project/")}>Project一覧へ戻る</a>
    </div>
  </article>
</BaseLayout>
