---
import { formatDate } from "../../shared/formatDate.js";
import SortSwitch from "../components/SortSwitch.astro";
import ListViewSwitch from "../components/ListViewSwitch.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getViewingWorks, galleryWorkPath } from "../utils/works";

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base : `${base}/`;
const href = (path) => `${basePath}${path.replace(/^\/+/, "")}`;
const works = (await getViewingWorks()).map((work) => ({ ...work, href: href(galleryWorkPath(work.id)), image: work.thumbnail, external: false }));
const allTags = [...new Set(works.flatMap((work) => work.tags))].sort((left, right) => left.localeCompare(right, "ja"));
---

<BaseLayout title="Works" description="イラスト・映像作品・楽曲をまとめた作品一覧。" wideContainer={true}>
  <h1 class="web_title">Works</h1>

  <div class="index-toolbar works-controls journal-entry-animate">
    <div class="filter-controls" role="group" aria-label="タグで絞り込み">
      <button type="button" aria-pressed="true" class="filter-btn active" data-filter="all">すべて</button>
      {allTags.map((tag) => (
        <button type="button" aria-pressed="false" class="filter-btn" data-filter={tag}>{tag}</button>
      ))}
    </div>
    <div class="index-view-controls"><SortSwitch target="gallery-container" /><ListViewSwitch target="gallery-container" page="works" /></div>
  </div>

  <p>複数のタグを選ぶと、いずれかに該当する作品を表示します。</p>
  <p data-filter-status role="status">{works.length}件表示中</p>
  <p data-filter-empty hidden>該当する作品はありません。</p>
  <div class="content-index" id="gallery-container" data-view="grid">
    {works.map((work) => (
      <article class="gallery-item content-item journal-row works-row journal-entry-animate" data-work-kind={work.kind} data-date={work.date} data-categories={work.tags.join(",")}>
        <a href={work.href} class="journal-thumb" target={work.external ? "_blank" : undefined} rel={work.external ? "noopener noreferrer" : undefined}>
          <img src={work.image} alt={work.imageAlt} loading="lazy" />
        </a>
        <div class="journal-copy">
          <time datetime={work.date} class="journal-date">{formatDate(work.date)}</time>
          <h2 class="journal-title"><a href={work.href} target={work.external ? "_blank" : undefined} rel={work.external ? "noopener noreferrer" : undefined}>{work.title}</a></h2>
          <p class="journal-desc">{work.description}</p>
          <div class="work-tags" aria-label={`${work.title} tags`}>
            {work.tags.map((tag) => <span class="work-tag">{tag}</span>)}
          </div>
        </div>
      </article>
    ))}
  </div>
</BaseLayout>
