---
import { renderSiteMarkdown } from "../../utils/siteEmbeds";
import { galleryWorkPath, workReference } from "../../../shared/workIdentity";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base : `${base}/`;
const withBase = (path) => `${basePath}${path.replace(/^\/+/, "")}`;

export async function getStaticPaths() {
  const showDraftPaths = !import.meta.env.PROD;
  const songs = (await getCollection("songs")).filter((entry) => showDraftPaths || !entry.data.draft);
  return songs.map((song) => ({
    params: {
      slug: song.slug
    },
    props: {
      song
    }
  }));
}

const { song } = Astro.props;
const bodyHtml = await renderSiteMarkdown(song.body);
const credits = Array.isArray(song.data.credits) ? song.data.credits.join("\n") : song.data.credits;
const entryDateIso = song.id.split("/").pop()?.replace(/\.md$/, "") ?? song.data.date.toISOString().slice(0, 10);
---

<BaseLayout
  title={song.data.title}
  description={song.data.description ?? song.data.title}
  ogTitle={song.data.title}
  ogDescription={song.data.description ?? song.data.title}
  ogType="article"
  ogImage={`https://i.ytimg.com/vi/${song.data.youtube_id}/hqdefault.jpg`}
  ogImageAlt={song.data.title}
  ogImageWidth={480}
  ogImageHeight={360}
>
  <article class="post journal-article song-article">
    <div class="journal-back-link journal-back-link-top">
      <a href={withBase("/works/")}>Works一覧へ戻る</a>
      <a href={withBase(galleryWorkPath(workReference("songs", song.slug)))}>Galleryで鑑賞する</a>
    </div>

    <header class="journal-hero">
      <p class="journal-date"><time datetime={entryDateIso}>
        {song.data.date.getFullYear()}年{String(song.data.date.getMonth() + 1).padStart(2, "0")}月{String(song.data.date.getDate()).padStart(2, "0")}日
      </time></p>
      <h1 class="page_title">{song.data.title}</h1>
      {song.data.description && <p class="journal-summary">{song.data.description}</p>}
    </header>

    <div class="post-content journal-content song-content">
      <div class="song-video responsive-video-container">
        <iframe
          width="560"
          height="315"
          src={`https://www.youtube.com/embed/${song.data.youtube_id}`}
          title={song.data.title}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        ></iframe>
      </div>
      <div class="rendered-markdown" set:html={bodyHtml} />
    </div>

    {credits && (
      <section class="post-info song-meta">
        <div class="post-credits">
          <h3>クレジット</h3>
          <pre>{credits}</pre>
        </div>
      </section>
    )}

    {song.data.lyrics && (
      <section class="post-lyrics">
        <details id="lyrics-details">
          <summary>歌詞</summary>
          <pre>{song.data.lyrics}</pre>
        </details>
      </section>
    )}

    <div class="journal-back-link">
      <a href={withBase("/works/")}>Works一覧へ戻る</a>
      <a href={withBase(galleryWorkPath(workReference("songs", song.slug)))}>Galleryで鑑賞する</a>
    </div>
  </article>
</BaseLayout>
