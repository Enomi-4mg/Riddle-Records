---
import BaseLayout from "../../layouts/BaseLayout.astro";
const target = `${import.meta.env.BASE_URL}gallery/?filter=music`;
---
<BaseLayout title="Discography" description="楽曲の鑑賞はGalleryへ移動しました。">
  <meta http-equiv="refresh" content={`0;url=${target}`} />
  <h1 class="web_title">Discography</h1>
  <p>楽曲はGalleryで鑑賞できます。<a href={target}>Musicを開く</a></p>
</BaseLayout>
<script>
  const link = document.querySelector<HTMLAnchorElement>('a[href$="gallery/?filter=music"]');
  if (link) location.replace(link.href);
</script>
