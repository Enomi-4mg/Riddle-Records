{
  "name": "riddle-journal-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:worker": "tsc --noEmit --skipLibCheck --target ES2022 --module ESNext --moduleResolution Bundler --lib ES2022,WebWorker worker/index.ts",
    "deploy": "npm run build && wrangler deploy",
    "preview": "vite preview",
    "test:yaml": "node scripts/test-yaml-frontmatter.mjs",
    "test:unit": "node --experimental-loader ./scripts/typescript-loader.mjs --test scripts/unit-tests.mjs scripts/cms-tests.mjs scripts/api-tests.mjs scripts/tag-input-tests.mjs scripts/embeds-tests.mjs scripts/embed-editor-tests.mjs",
    "test:coverage": "node --experimental-loader ./scripts/typescript-loader.mjs --test --experimental-test-coverage --test-coverage-include='src/lib/cmsMarkdown.ts' --test-coverage-include='src/lib/editorMarkdown.ts' --test-coverage-include='src/lib/deployPending.ts' --test-coverage-include='src/lib/commitBatch.ts' --test-coverage-include='src/lib/mediaRegistry.ts' --test-coverage-include='src/lib/articleDefaults.ts' --test-coverage-include='src/lib/siteDeploy.ts' --test-coverage-include='src/lib/contentFiles.ts' --test-coverage-include='src/lib/pendingChanges.ts' --test-coverage-include='src/components/TagInput.tsx' --test-coverage-include='src/types/media.ts' --test-coverage-include='../src/utils/*.ts' --test-coverage-include='worker/index.ts' --test-coverage-include='vite.config.ts' scripts/unit-tests.mjs scripts/cms-tests.mjs scripts/api-tests.mjs scripts/tag-input-tests.mjs",
    "test:roundtrip:journal": "node --experimental-loader ./scripts/typescript-loader.mjs scripts/roundtrip-journal.mjs",
    "test:roundtrip:songs": "node --experimental-loader ./scripts/typescript-loader.mjs scripts/roundtrip-songs.mjs",
    "test:roundtrip:gallery": "node --experimental-loader ./scripts/typescript-loader.mjs scripts/roundtrip-content-kind.mjs gallery",
    "test:roundtrip:projects": "node --experimental-loader ./scripts/typescript-loader.mjs scripts/roundtrip-content-kind.mjs projects",
    "test:roundtrip": "npm run test:roundtrip:journal && npm run test:roundtrip:songs && npm run test:roundtrip:gallery && npm run test:roundtrip:projects",
    "test:content": "npm run test:roundtrip",
    "test": "npm run test:unit && npm run test:roundtrip && npm run test:legacy",
    "test:roundtrip:write": "node --experimental-loader ./scripts/typescript-loader.mjs scripts/roundtrip-journal.mjs --write-exported ./roundtrip-exported",
    "media:rebuild": "node scripts/build-media-registry.mjs",
    "test:legacy": "npm run test:yaml && node --experimental-loader ./scripts/typescript-loader.mjs --test scripts/legacy-tests.mjs"
  },
  "dependencies": {
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-list": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@vitejs/plugin-react": "^4.3.4",
    "js-yaml": "^5.2.1",
    "marked": "^15.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "turndown": "^7.2.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "happy-dom": "^20.14.5",
    "wrangler": "4.142.0"
  }
}
