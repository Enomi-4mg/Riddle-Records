{
  "compilerOptions": {
    "composite": true,
    "outDir": "./.cache/types",
    "skipLibCheck": true,
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "rootDir": ".."
  },
  "include": [
    "vite.config.ts",
    "src/types/media.ts",
    "src/types/content.ts",
    "src/types/journal.ts",
    "src/lib/cmsMarkdown.ts",
    "src/lib/permalink.ts",
    "src/lib/managedValidation.ts",
    "../shared/aboutProfile.ts",
    "../shared/contentStorage.ts",
    "../shared/contentTags.ts",
    "../shared/workIdentity.ts",
    "../shared/linkMetadata.ts",
    "../shared/embeds.ts"
  ]
}
